<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Cleared so a machine-wide or parent-directory NuGet.config cannot inject a private feed into a
    public build. nuget.org is the only source this repository needs.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
