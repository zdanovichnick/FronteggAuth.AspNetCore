{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FronteggSettings": {
    "ClientId": "",
    "Authority": "https://auth.example.com",
    "ApiBaseUrl": "https://api.frontegg.com",

    // Machine-to-machine and API-key tokens are often issued by the raw Frontegg domain rather than your
    // custom login domain. Set this when their `iss` differs from Authority; leave it out and they are
    // validated against Authority.
    // "ApiTokenAuthority": "https://app-xxxx.frontegg.com",

    // Only needed by /api/diagnostics/tenant-token. TenantSecret is a credential — user-secrets, not here.
    // "TenantClientId": "",

    "PermissionIdMappings": {
      "101": "sample.reports.delete"
    }
  }
}
